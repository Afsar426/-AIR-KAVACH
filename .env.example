# AIR KAVACH - Environment Variables Template
# Copy this file to .env and set your credentials

# OpenAQ API Key (Optional for v3 public API endpoints, required for high-rate API access)
OPENAQ_API_KEY=your_openaq_api_key_here

# LLM API Configuration (Optional: system uses fallback deterministic routing if not provided)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backend & Server Settings
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Storage & Model Settings
DATA_DIR=data
MODELS_DIR=models
REPORTS_DIR=reports
